{
  "name": "stichting-bam-frontend",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "node scripts/reset-report.mjs && nuxt generate",
    "generate": "node scripts/reset-report.mjs && nuxt generate",
    "verify": "node scripts/verify-build.mjs",
    "release": "node scripts/reset-report.mjs && nuxt generate && node scripts/verify-build.mjs && node scripts/stage-release.mjs",
    "preview": "npx --yes serve .output/public",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "nuxt": "^3.14.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.6.0",
    "vue-tsc": "^2.1.0"
  }
}
