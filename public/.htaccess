# ============================================================================
# Stichting BAM — statische Nuxt-build op Apache (Vimexx shared hosting)
# ============================================================================
# Dit bestand staat in `public/` en komt daardoor ongewijzigd in
# `.output/public/.htaccess` terecht. Kopieer de HELE inhoud van
# `.output/public/` naar `public_html/`.
#
# CANONIEKE URL-VORM: https://www.stichting-bam.nl/over-ons
#   - met www
#   - zonder trailing slash
# Zie het blok "Canonieke vorm" hieronder. Deze keuze komt overeen met de
# NuxtLinks in de app en met de URL's in sitemap.xml.
# ============================================================================

Options -Indexes

# Apache zet standaard een 301 naar /map/ zodra een pad een bestaande map is.
# Dat zou elke interne link een extra redirect geven; wij serveren het
# index.html-bestand rechtstreeks (zie de RewriteRule verderop).
DirectorySlash Off

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── Canonieke vorm ────────────────────────────────────────────────────────
  # `public_html/cms/` is de document root van de WordPress-installatie op
  # cms.stichting-bam.nl — een APARTE site, maar wel een submap van deze map.
  # Apache voegt `.htaccess` van bovenliggende mappen samen met submappen, dus
  # ErrorDocument/Options/Header/mod_expires-directives hieronder gelden ook
  # daar. mod_rewrite-regels doen dat NIET zodra WordPress zijn eigen
  # `RewriteEngine On` heeft (elke `RewriteEngine On` in een submap begint een
  # nieuwe keten, niets uit een bovenliggende map wordt overgenomen) — maar
  # reken daar niet op als enige vangrail: de regels hieronder matchen daarom
  # expliciet op onze eigen hostnamen (`stichting-bam.nl` / `www.`), nooit op
  # "is geen www" of "is geen localhost". Zo'n negatieve vorm matcht namelijk
  # óók cms.stichting-bam.nl en stuurt WordPress door naar het hoofddomein.
  # Met een expliciete allowlist werkt lokaal testen op `localhost` vanzelf
  # (die host matcht geen van beide condities), zonder aparte uitzondering.

  # 1. Forceer HTTPS, alleen op onze eigen hosts.
  RewriteCond %{HTTP_HOST} ^(www\.)?stichting-bam\.nl$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://www.stichting-bam.nl/$1 [R=301,L]

  # 2. Forceer de www-variant (apex -> www). Verboden vorm: een conditie op
  #    "ontbreekt www" (`!^www\.`) — die geldt ook voor cms.stichting-bam.nl.
  RewriteCond %{HTTP_HOST} ^stichting-bam\.nl$ [NC]
  RewriteRule ^ https://www.stichting-bam.nl%{REQUEST_URI} [L,R=301]

  # 3. Strip de trailing slash (behalve op de site-root), zodat /over-ons/
  #    doorverwijst naar /over-ons.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.*)/$ /$1 [R=301,L]

  # ── Statische bestanden serveren ──────────────────────────────────────────
  # Bestaande bestanden ongemoeid laten.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # /over-ons  ->  /over-ons/index.html, zonder redirect.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]
</IfModule>

# ── Foutpagina ──────────────────────────────────────────────────────────────
# Door Nuxt gegenereerd (staat in nitro.prerender.routes).
ErrorDocument 404 /404.html

# ── Compressie ──────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Caching ─────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Alles onder /_nuxt/ heeft een content-hash in de bestandsnaam: een nieuwe
  # inhoud krijgt een nieuwe naam. Die mag dus eeuwig gecachet worden.
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/_nuxt/" LONG_CACHE=1
  </IfModule>
  Header set Cache-Control "public, max-age=31536000, immutable" env=LONG_CACHE

  # HTML heeft GEEN hash in de naam. Zonder no-cache blijven bezoekers na een
  # deploy de oude pagina zien, inclusief verwijzingen naar verwijderde assets.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # De payloads horen bij de HTML en moeten dus even vers zijn.
  <FilesMatch "_payload\.json$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Losse assets buiten /_nuxt/ (bijv. uit public/).
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Verberg dit bestand zelf.
<Files ".htaccess">
  Require all denied
</Files>

# De FTP-deploy (SamKirkland/FTP-Deploy-Action) zet dit bestand in server-dir
# om bij te houden welke bestanden al geüpload zijn — een volledige
# bestandsinventaris van de site, en dus niet iets om publiek opvraagbaar te
# laten staan.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
