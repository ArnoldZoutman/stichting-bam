# Kopieer naar `.env` en vul in waar nodig. `.env` staat in .gitignore en hoort
# NOOIT in de repository. Er zijn geen secrets nodig: alle calls richting
# WordPress zijn anonieme GET-requests op publieke content.

# Basis-URL van de WordPress REST API, zonder slash op het eind.
# Default als deze niet is gezet: https://www.stichting-bam.nl/wp-json
# Zet dit om tegen een andere WordPress-installatie te bouwen (acceptatie, of
# na een verhuizing van WordPress naar een ander adres).
NUXT_WP_BASE=

# Publieke URL van DEZE frontend. Wordt gebruikt voor canonical-tags, Open
# Graph-URL's, robots.txt en sitemap.xml.
# Default als deze niet is gezet: http://localhost:3000
# Voor productie: https://www.stichting-bam.nl
NUXT_PUBLIC_SITE_URL=
