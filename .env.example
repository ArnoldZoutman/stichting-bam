# Kopieer naar `.env` en vul in waar nodig. `.env` staat in .gitignore en hoort
# NOOIT in de repository. Er zijn geen secrets nodig: alle calls richting
# WordPress zijn anonieme GET-requests op publieke content.

# Basis-URL van de WordPress REST API, zonder slash op het eind.
# Default als deze niet is gezet: https://www.stichting-bam.nl/wp-json
# Zet dit om tegen een andere WordPress-installatie te bouwen (acceptatie, of
# na een verhuizing van WordPress naar een ander adres).
NUXT_WP_BASE=

# Publieke URL van DEZE frontend. Wordt gebruikt voor canonical-tags, Open
# Graph-URL's, robots.txt en sitemap.xml.
# Default als deze niet is gezet: http://localhost:3000
# Voor productie: https://www.stichting-bam.nl
NUXT_PUBLIC_SITE_URL=

# Google Analytics 4 meet-ID. LAAT DIT LOKAAL LEEG.
# Is deze variabele leeg of niet gezet, dan komt er geen analytics-tag in de
# HTML — niet in `yarn dev` en niet in een lokale `yarn generate`/`yarn release`.
# Alleen .github/workflows/build-deploy.yml zet hem (G-80ZJBF3N04), zodat er
# uitsluitend op de gepubliceerde site gemeten wordt.
# Het ID is geen secret (het staat in de HTML van elke bezoeker); hoort dus
# niet in GitHub Secrets. Het staat hier bewust NIET ingevuld: een gevulde
# waarde in je eigen .env zou je testbuilds meetellen in de statistieken.
# De faal-check controleert beide kanten: gezet → de tag moet op elke pagina
# staan, leeg → hij mag nergens staan.
GA_MEASUREMENT_ID=

# ============================================================================
# GitHub Actions — GEEN lokale .env-variabelen, hier alleen ter documentatie.
# Instellen als repo-secrets (Settings → Secrets and variables → Actions),
# nooit als waarde in dit bestand of ergens anders in de repo.
# Zie .github/workflows/build-deploy.yml en README.md ("Automatische deploy").
# ============================================================================
# FTP_HOST      — web0087.zxcs.nl
# FTP_USER      — arnold@stichting-bam.nl
# FTP_PASSWORD  — (wachtwoord van bovenstaande gebruiker)
# WP_API_BASE   — NUXT_WP_BASE tijdens de build, in productie
#                 https://cms.stichting-bam.nl/wp-json
